#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

echo "=================================================="
echo "  Running coralnpu pre-push checks (Podman)..."
echo "=================================================="

# 1. Check macro signatures (native python check)
echo "[1/3] Checking macro signatures..."
"${REPO_ROOT}/utils/check_macro_signatures.py"

# 2. Configure Host Bazel Cache Directories
HOST_CACHE_ROOT="/tmp/coralnpu_bazel_cache_${USER:-$(id -un)}"
HOST_BAZEL_HOME_CACHE="${HOST_CACHE_ROOT}/cache_bazel"
HOST_BAZEL_DISK_CACHE="${HOST_CACHE_ROOT}/disk_cache"
mkdir -p "${HOST_BAZEL_HOME_CACHE}" "${HOST_BAZEL_DISK_CACHE}"

# 3. Configure Podman invocation
USER_NS_ARG="--userns=keep-id:uid=1000,gid=1000"
if ! podman run --help 2>&1 | grep -q 'userns'; then
  USER_NS_ARG=""
fi

PODMAN_RUN=(
  podman run
  ${USER_NS_ARG}
  --pids-limit=-1
  --rm
  -v "${REPO_ROOT}:${REPO_ROOT}"
  -w "${REPO_ROOT}"
  -v "${HOST_BAZEL_HOME_CACHE}:/home/builder/.cache/bazel"
  -v "${HOST_BAZEL_DISK_CACHE}:/tmp/coralnpu_bazel_cache"
  localhost/coralnpu-validation
  bash -c
)

# 4. Run linters inside Podman
echo "[2/3] Running codebase linters inside Podman..."
"${PODMAN_RUN[@]}" "git config --global --add safe.directory '${REPO_ROOT}' && ${REPO_ROOT}/utils/run_linters.sh"

# 5. Run full Bazel build and test inside Podman
echo "[3/3] Running bazel build //... && bazel test //... inside Podman..."
"${PODMAN_RUN[@]}" "git config --global --add safe.directory '${REPO_ROOT}' && bazel build //... && bazel test //..."

echo "=================================================="
echo "  Pre-push checks passed successfully!"
echo "=================================================="
exit 0
