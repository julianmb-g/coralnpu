ALL_BINS = [
    "{}.elf".format(binary)
    for binary in (
        OUT_BINARIES_RV32UI +
        OUT_BINARIES_RV32UM +
        OUT_BINARIES_RV32UF +
        OUT_BINARIES_RV32UZBB
    )
]

genrule(
    name = "all_isa_binaries",
    srcs = [":all_files"],
    outs = ALL_BINS,
    cmd = """
      for dir in $(SRCS); do
        for f in $$dir/isa/*; do
          base=$$(basename $$f)
          extension="$${base##*.}"
          if [[ "$${base}" != "dump" ]]; then
              cp "$${f}" "$(@D)/$${base}.elf"
          fi
        done
      done
    """,
)

collect_coralnpu_riscv_tests(binaries = ALL_BINS)
